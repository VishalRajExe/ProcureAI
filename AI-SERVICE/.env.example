# ProcureAI AI Service — Environment Variables
# Copy this file to .env and fill in your values

# ── Required for REAL AI MODE ─────────────────────────────────
# Gemini API key from https://aistudio.google.com/app/apikey
# Leave empty to run in DEMO MODE (deterministic mock responses)
GEMINI_API_KEY=

# ── Optional overrides ────────────────────────────────────────
# Gemini model (default: gemini-1.5-flash-latest)
# GEMINI_MODEL=gemini-1.5-flash-latest

# Max characters sent to Gemini per request (default: 40000)
# AI_MAX_INPUT_CHARS=40000

# Gemini request timeout seconds (default: 45)
# AI_REQUEST_TIMEOUT_S=45

# ── Security ──────────────────────────────────────────────────
# Optional: internal shared token for Spring Boot → FastAPI calls
# Set same value in Spring Boot as PYTHON_AI_INTERNAL_TOKEN
# AI_INTERNAL_TOKEN=

# ── Service config ────────────────────────────────────────────
# Allowed CORS origin for Spring Boot (default: http://localhost:8080)
# SPRING_BOOT_ORIGIN=http://localhost:8080
