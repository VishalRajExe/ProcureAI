# Copy to .env and fill in for real usage. App runs with safe defaults (H2 + Mock AI) without this file.

# --- Database (only needed for 'mysql' profile) ---
DB_URL=jdbc:mysql://localhost:3306/procureai?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change_me

# --- JWT ---
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars

# --- AI Provider ---
# mock = deterministic offline AI (default, no key needed, demo-safe)
# openai / anthropic = real provider, requires AI_API_KEY
AI_PROVIDER=mock
AI_API_KEY=

# --- Email Provider ---
# mock = simulated vendor inbox (default, demo-safe)
# smtp = real email sending
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
